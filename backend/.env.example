# ── Supabase (local dev) ─────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<tu-anon-key-local>
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key-local>

# ── Supabase (producción) ────────────────────────────────────────────────────
# SUPABASE_URL=https://<tu-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<tu-anon-key-prod>
# SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key-prod>

# ── WhatsApp Business API (Meta) ─────────────────────────────────────────────
WA_WEBHOOK_VERIFY_TOKEN=mediflow_webhook_secret_123
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# ── Twilio (WhatsApp o SMS) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Twilio Webhook Secret (firma HMAC) ────────────────────────────────────────
TWILIO_WEBHOOK_SECRET=

# ── SMSMasivos.uy ────────────────────────────────────────────────────────────
SMSMASSIVOS_TOKEN=
SMSMASSIVOS_FROM=MEDIFLOW

# ── AWS SNS / SES ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── SendGrid / Resend ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=suplencias@tuorganizacion.com
EMAIL_FROM_NAME=Suplencias Médicas
